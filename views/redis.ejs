<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="refresh" content="5">
    <title>Redis Monitor — Auction House</title>
    <style>
        body { font-family: sans-serif; max-width: 800px; margin: 40px auto; padding: 0 1rem; }
        header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; }
        h1 { margin: 0; }
        .logout { background: none; border: 1px solid #333; padding: .4rem .8rem; cursor: pointer; }
        .back { display: inline-block; margin-bottom: 1.5rem; color: #555; text-decoration: none; }
        h2 { border-bottom: 1px solid #ddd; padding-bottom: .5rem; margin-top: 2rem; }
        .card { border: 1px solid #ddd; border-radius: 4px; padding: 1rem; margin-bottom: 1rem; background: #fafafa; }
        .card .key { font-family: monospace; font-size: .85rem; color: #888; margin-bottom: .5rem; }
        .card .row { display: flex; justify-content: space-between; font-size: .9rem; padding: .2rem 0; border-bottom: 1px solid #f0f0f0; }
        .card .row:last-child { border-bottom: none; }
        .card .row span:first-child { color: #555; }
        .ttl { font-size: .8rem; color: #aaa; margin-top: .5rem; }
        .empty { color: #999; }
        .badge { display: inline-block; background: #333; color: #fff; border-radius: 3px; padding: .15rem .4rem; font-size: .75rem; margin-left: .5rem; }
    </style>
</head>
<body>
    <header>
        <h1>Redis Monitor</h1>
        <form method="POST" action="/logout">
            <button class="logout" type="submit">Log out (<%= user.username %>)</button>
        </form>
    </header>

    <a class="back" href="/auctions">&larr; Back to auctions</a>

    <h2>Auction Cache <span class="badge"><%= auctions.length %> keys</span></h2>
    <% if (auctions.length === 0) { %>
        <p class="empty">No auctions in cache.</p>
    <% } else { %>
        <% auctions.forEach(a => { %>
        <div class="card">
            <div class="key"><%= a.key %></div>
            <div class="row"><span>Item</span><span><%= a.item_name %></span></div>
            <div class="row"><span>Status</span><span><%= a.status %></span></div>
            <div class="row"><span>Top Bid</span><span>$<%= parseFloat(a.top_bid).toFixed(2) %></span></div>
            <div class="row"><span>Ends</span><span><%= a.end_date ? new Date(a.end_date).toLocaleString() : 'Unknown' %></span></div>
            <div class="ttl">TTL: <%= a.ttl %>s remaining</div>
        </div>
        <% }) %>
    <% } %>

    <h2>Chat Cache <span class="badge"><%= chats.length %> keys</span></h2>
    <% if (chats.length === 0) { %>
        <p class="empty">No chat messages in cache.</p>
    <% } else { %>
        <% chats.forEach(c => { %>
        <div class="card">
            <div class="key"><%= c.key %></div>
            <div class="row"><span>Messages stored</span><span><%= c.count %> / 50</span></div>
        </div>
        <% }) %>
    <% } %>

    <p style="color:#aaa; font-size:.8rem; margin-top:2rem;">Page shows a snapshot — refresh to update.</p>
</body>
</html>