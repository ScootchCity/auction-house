<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Dev Tools — Auction House</title>
    <style>
        body { font-family: sans-serif; max-width: 700px; margin: 40px auto; padding: 0 1rem; }
        header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; }
        h1 { margin: 0; }
        .logout { background: none; border: 1px solid #333; padding: .4rem .8rem; cursor: pointer; }
        .back { display: inline-block; margin-bottom: 1.5rem; color: #555; text-decoration: none; }
        .notice { background: #fff8e1; border: 1px solid #f0c000; padding: .75rem 1rem; border-radius: 4px; margin-bottom: 1.5rem; font-size: .9rem; }
        .success { background: #e8f5e9; border: 1px solid #66bb6a; padding: .75rem 1rem; border-radius: 4px; margin-bottom: 1.5rem; font-size: .9rem; }
        table { width: 100%; border-collapse: collapse; }
        th { text-align: left; padding: .5rem; border-bottom: 2px solid #ddd; color: #555; font-size: .85rem; text-transform: uppercase; }
        td { padding: .6rem .5rem; border-bottom: 1px solid #eee; vertical-align: middle; }
        .close-btn { background: #c0392b; color: #fff; border: none; padding: .35rem .75rem; cursor: pointer; border-radius: 3px; }
        .close-btn:hover { background: #a93226; }
        .empty { color: #999; }
    </style>
</head>
<body>
    <header>
        <h1>Dev Tools</h1>
        <form method="POST" action="/logout">
            <button class="logout" type="submit">Log out (<%= user.username %>)</button>
        </form>
    </header>

    <a class="back" href="/auctions">&larr; Back to auctions</a>

    <div class="notice">⚠️ Dev-only. Force-closing marks the auction Finished in Postgres and removes it from Redis — same as natural expiry.</div>

    <% if (closed) { %>
        <div class="success">✓ Auction #<%= closed %> has been closed.</div>
    <% } %>

    <h2>Active Auctions</h2>

    <% if (auctions.length === 0) { %>
        <p class="empty">No active auctions.</p>
    <% } else { %>
        <table>
            <tr><th>ID</th><th>Item</th><th>Top Bid</th><th>Ends</th><th></th></tr>
            <% auctions.forEach(a => { %>
            <tr>
                <td>#<%= a.id %></td>
                <td><a href="/auctions/<%= a.id %>"><%= a.item_name %></a></td>
                <td>$<%= parseFloat(a.top_bid).toFixed(2) %></td>
                <td><%= new Date(a.end_date).toLocaleString() %></td>
                <td>
                    <form method="POST" action="/dev/close/<%= a.id %>" onsubmit="return confirm('Force-close #<%= a.id %>?')">
                        <button class="close-btn" type="submit">Force Close</button>
                    </form>
                </td>
            </tr>
            <% }) %>
        </table>
    <% } %>
</body>
</html>